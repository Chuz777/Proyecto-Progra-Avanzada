@model Proyecto.Models.DTOs.VehiculoDTO

@{
    ViewBag.Title = "Detalle del Vehículo";
}

<div class="page-header">
    <span class="label">Ficha Técnica</span>
    <h2>@Model.Marca @Model.Modelo</h2>
</div>

<div class="page-content">
    <div class="card-vehiculo" style="max-width: 600px; margin: 0 auto;">
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" alt="@Model.Modelo" style="height: 300px;" />
        }
        <div class="card-body">
            <span class="badge @(Model.Estado == "Disponible" ? "disponible" : Model.Estado == "Reservado" ? "reservado" : "vendido")">
                @Model.Estado
            </span>

            <span class="precio" style="font-size: 1.5rem; margin-top: .5rem;">₡@Model.Precio.ToString("N0")</span>
            <p class="descripcion">@Model.Descripcion</p>

            <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border); padding: 1rem; border-radius: 6px; margin: 1rem 0;">
                <p style="color: var(--muted); font-family: var(--font-mono); font-size: .85rem; margin-bottom: .4rem;">
                    <strong>Marca:</strong> @Model.Marca — <strong>Año:</strong> @Model.Anio
                </p>
                <p style="color: var(--muted); font-family: var(--font-mono); font-size: .85rem; margin: 0;">
                    <strong>VIN:</strong> @Model.VIN
                </p>
            </div>

            <div class="card-actions" style="grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: .5rem;">
                <a class="boton btn-secondary" href="@Url.Action("Index", "Autos")">Volver</a>
                <a class="boton btn-secondary" href="@Url.Action("Calcular", "Cotizador", new { vehiculoId = Model.Id })">Cotizar</a>


                <a href="@Url.Action("Create", "Reservas", new { vehiculoId = Model.Id })" class="boton btn-primary">Reservar Cita</a>

                @if (ViewBag.EsVendedor == true)
                {
                    <a class="boton btn-secondary" href="@Url.Action("Edit", "Vehiculos", new { id = Model.Id })">Editar</a>
                    <a class="boton btn-danger" href="@Url.Action("Delete", "Vehiculos", new { id = Model.Id })">Eliminar</a>
                }
            </div>
        </div>
    </div>
</div>