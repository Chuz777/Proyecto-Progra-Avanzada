@model Proyecto.Models.Entities.Sucursal

@{
    ViewBag.Title = "Eliminar Sucursal";
}

<div class="page-header">
    <span class="label">Sucursales</span>
    <h2>Confirmar Eliminación</h2>
</div>

<div class="page-content">
    <p style="color:#7a7f8e; margin-bottom:1.5rem;">
        ¿Seguro que quieres eliminar esta sucursal? Esta acción no se puede deshacer.
    </p>

    <div class="card-vehiculo" style="max-width:400px; margin-bottom:1.5rem;">
        <div class="card-body">
            <h3>@Model.Nombre</h3>
            <span class="descripcion">@Model.Direccion</span>
            <span class="descripcion">Tel: @Model.Telefono</span>
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <button type="submit" class="boton btn-danger">Sí, Eliminar</button>
        <a class="boton btn-secondary" href="@Url.Action("Index")">Cancelar</a>
    }
</div>