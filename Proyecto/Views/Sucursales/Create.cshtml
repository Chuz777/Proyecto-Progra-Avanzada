@model Proyecto.Models.Entities.Sucursal
@{
    ViewBag.Title = "Agregar Sucursal";
}

<div class="page-header">
    <span class="label">Sucursales</span>
    <h2>Añadir nueva sucursal</h2>
</div>

<div class="page-content">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="form-grid">
            <div class="form-group full">
                <label>Nombre</label>
                @Html.TextBoxFor(m => m.Nombre)
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Dirección</label>
                @Html.TextBoxFor(m => m.Direccion)
                @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Teléfono</label>
                @Html.TextBoxFor(m => m.Telefono)
                @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
            </div>

            <div class="form-group full">
                <button type="submit" class="boton btn-primary">Guardar Sucursal</button>
                <a class="boton btn-secondary" href="@Url.Action("Index")">Cancelar</a>
            </div>
        </div>
    }
</div>