@model Proyecto.Models.Entities.Vehiculo

@{
    ViewBag.Title = "Eliminar Vehículo";
}

<div class="page-header">
    <span class="label">Inventario</span>
    <h2>Confirmar Eliminación</h2>
</div>

<div class="page-content">
    <p style="color:#7a7f8e; margin-bottom:1.5rem;">
        ¿Seguro que quieres eliminar este vehículo? Esta acción no se puede deshacer.
    </p>

    <div class="card-vehiculo" style="max-width:400px; margin-bottom:1.5rem;">
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" alt="@Model.Modelo" />
        }
        <div class="card-body">
            <h3>@Model.Modelo</h3>
            <span class="precio">₡@Model.Precio.ToString("N0")</span>
            <span class="descripcion">@Model.Descripcion</span>
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <button type="submit" class="boton btn-danger">Sí, Eliminar</button>
        <a class="boton btn-secondary" href="@Url.Action("Index")">Cancelar</a>
    }
</div>
