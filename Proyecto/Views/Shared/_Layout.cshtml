<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title — Concesionario Digital</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <nav>
        <a class="nav-brand" href="@Url.Action("Index", "Home")"><span>CD</span> CONCESIONARIO</a>

        <div class="nav-links">
            <a href="@Url.Action("Index", "Autos")">Autos</a>
            <a href="@Url.Action("Index", "Motos")">Motos</a>
            <a href="@Url.Action("Index", "Reservas")">Reservas</a>
            <a href="@Url.Action("Index", "Sucursales")">Sucursales</a>

            @if (ViewBag.RolActual == "Admin")
            {
                <a href="@Url.Action("Index", "Admin")">Admin</a>
            }
            @if (ViewBag.RolActual == "Admin" || ViewBag.RolActual == "Asesor")
            {
                <a href="@Url.Action("Index", "Vendedor")">Vendedor</a>
            }
        </div>

        <div class="nav-user">
            @if (ViewBag.UsuarioActual != null)
            {
                <span class="nav-username">@ViewBag.UsuarioActual</span>
                <a class="nav-salir" href="@Url.Action("Logout", "Account")">Salir</a>
            }
            else
            {
                <a href="@Url.Action("Register", "Account")">Registrarse</a>
                <a href="@Url.Action("Login", "Account")">Ingresar</a>
            }
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>© 2026 Concesionario Digital — San José, Costa Rica</footer>

</body>
</html>