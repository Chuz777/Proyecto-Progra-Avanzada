@model Proyecto.Models.Entities.Cotizador
@{
    ViewBag.Title = "Comprobante de Cotización";
    var cuota = Model.CalcularCuotaMensual(8.5m);
}

<div class="page-header">
    <span class="label">Documento Oficial</span>
    <h2>Resumen de Cotización #@Model.Id</h2>
</div>

<div class="page-content">
    <div class="card-vehiculo comprobante-card">

        <!-- Encabezado del Comprobante -->
        <div class="comprobante-header">
            <div>
                <h3 class="nav-brand">CONCESIONARIO <span>DIGITAL</span></h3>
                <p class="badge">Costa Rica</p>
            </div>
            <div class="comprobante-folio">
                <p class="precio">FOLIO: #COT-@Model.Id</p>
                <p class="descripcion">
                    Fecha: @Model.FechaCotizacion.ToString("dd/MM/yyyy HH:mm")
                </p>
            </div>
        </div>

        <!-- Datos del Cliente (Persistidos en Base de Datos) -->
        <div class="comprobante-cliente">
            <label>Datos del Cliente</label>
            <p><strong>👤 Cliente:</strong> @(string.IsNullOrEmpty(Model.NombreCliente) ? "Sin registrar" : Model.NombreCliente)</p>
            <p class="descripcion"><strong>✉ Correo:</strong> @(string.IsNullOrEmpty(Model.EmailCliente) ? "Sin registrar" : Model.EmailCliente)</p>
        </div>

        <!-- Detalles Financieros -->
        <table class="tabla-admin">
            <thead>
                <tr>
                    <th>Concepto</th>
                    <th>Monto / Detalle</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Precio Final del Vehículo</td>
                    <td><strong>₡@Model.PrecioFinal.ToString("N0")</strong></td>
                </tr>
                <tr>
                    <td>Prima Sugerida</td>
                    <td><span class="precio">₡@Model.PrimaSugerida.ToString("N0")</span></td>
                </tr>
                <tr>
                    <td>Plazo Financiamiento</td>
                    <td>@Model.PlazoMeses Meses</td>
                </tr>
                <tr>
                    <td>Tasa Estimada Anual</td>
                    <td>8.50%</td>
                </tr>
                <tr>
                    <td><strong class="badge disponible">Cuota Mensual Estimada</strong></td>
                    <td>
                        <strong class="badge disponible">₡@cuota.ToString("N0") / mes</strong>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Nota aclaratoria -->
        <p class="descripcion comprobante-nota">
            * Presente este documento en la sucursal con el número de folio para validar la oferta. Las cuotas y la aprobación del crédito están sujetas a análisis financiero por parte de las entidades bancarias asociadas.
        </p>

        <!-- Botones de Acción -->
        <div class="hero-actions no-print">
            <button onclick="window.print();" class="boton btn-primary">
                🖨 Imprimir / Guardar PDF
            </button>
            <a href="@Url.Action("Index", "Home")" class="boton btn-secondary">
                🏠 Volver al Inicio
            </a>
        </div>

    </div>
</div>