
@model Proyecto.Models.Entities.ReservaVisita

@{
    ViewBag.Title = "Detalles de la Reserva";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Detalles de la Reserva #@Model.Id</h4>
                        <div>
                            <span class="badge bg-@GetBadgeColor(Model.EstadoReserva)">
                                @Model.EstadoReserva
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- Información de la Reserva -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5 class="text-muted">Número de Reserva</h5>
                            <p class="fs-6"><strong>#@Model.Id</strong></p>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted">Estado</h5>
                            <p class="fs-6">
                                <span class="badge bg-@GetBadgeColor(Model.EstadoReserva) fs-6 p-2">
                                    @Model.EstadoReserva
                                </span>
                            </p>
                        </div>
                    </div>

                    <hr />

                    <!-- Información del Vehículo -->
                    @if (Model.Vehiculo != null)
                    {
                        <h5 class="text-primary mb-3">Información del Vehículo</h5>
                        <div class="row mb-4">
                            <div class="col-md-4">
                                @if (!string.IsNullOrEmpty(Model.Vehiculo.ImagenUrl))
                                {
                                    <img src="@Model.Vehiculo.ImagenUrl" alt="@Model.Vehiculo.Marca @Model.Vehiculo.Modelo" class="img-fluid img-thumbnail" style="height: 250px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-light text-center py-5" style="height: 250px; display: flex; align-items: center; justify-content: center;">
                                        <p class="text-muted mb-0">Sin imagen disponible</p>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <table class="table table-sm">
                                    <tbody>
                                        <tr>
                                            <td><strong>Marca:</strong></td>
                                            <td>@Model.Vehiculo.Marca</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Modelo:</strong></td>
                                            <td>@Model.Vehiculo.Modelo</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Año:</strong></td>
                                            <td>@Model.Vehiculo.Anio</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Precio:</strong></td>
                                            <td class="text-success"><strong>₡@Model.Vehiculo.Precio.ToString("N0")</strong></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Estado:</strong></td>
                                            <td>
                                                <span class="badge bg-@GetVehiculoBadgeColor(Model.Vehiculo.Estado)">
                                                    @Model.Vehiculo.Estado
                                                </span>
                                            </td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(Model.Vehiculo.VIN))
                                        {
                                            <tr>
                                                <td><strong>VIN:</strong></td>
                                                <td><small>@Model.Vehiculo.VIN</small></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <hr />

                        <h6 class="mb-2">Descripción</h6>
                        <p class="text-muted">@Model.Vehiculo.Descripcion</p>

                        <hr />
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            <strong>Advertencia:</strong> El vehículo no se encuentra disponible.
                        </div>
                    }

                    <!-- Información de la Cita -->
                    <h5 class="text-primary mb-3">Información de la Cita</h5>
                    <div class="alert alert-info" role="alert">
                        <div class="row">
                            <div class="col-md-6">
                                <i class="fas fa-calendar-alt text-primary"></i>
                                <strong>Fecha:</strong>

                                <span class="ms-4">@Model.FechaVista.ToString("dddd, dd 'de' MMMM 'de' yyyy")</span>
                            </div>
                            <div class="col-md-6">
                                <i class="fas fa-clock text-primary"></i>
                                <strong>Hora:</strong>

                                <span class="ms-4 fs-6"><strong>@Model.FechaVista.ToString("HH:mm")</strong></span>
                            </div>
                        </div>
                    </div>

                    @if (Model.EstadoReserva == "Pendiente")
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="fas fa-hourglass-half"></i>
                            <strong>Reserva Pendiente de Confirmación</strong>

                            <small>Nuestro equipo de ventas se pondrá en contacto contigo dentro de 24 horas para confirmar la cita.</small>
                        </div>
                    }
                    else if (Model.EstadoReserva == "Confirmada")
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="fas fa-check-circle"></i>
                            <strong>Reserva Confirmada</strong>

                            <small>¡Tu cita ha sido confirmada! Por favor, no olvides llegar 10-15 minutos antes de la hora programada.</small>
                        </div>
                    }
                    else if (Model.EstadoReserva == "Cancelada")
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-times-circle"></i>
                            <strong>Reserva Cancelada</strong>

                            <small>Esta reserva ha sido cancelada. Puedes crear una nueva reserva si lo deseas.</small>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light">
                    <div class="d-grid gap-2 d-sm-flex">
                        <a href="@Url.Action("Index", "Reservas")" class="btn btn-primary">
                            <i class="fas fa-arrow-left"></i> Volver a mis Citas
                        </a>

                        @if (Model.EstadoReserva != "Cancelada" && Model.Vehiculo != null)
                        {
                            <a href="@Url.Action("Details", "Vehiculos", new { id = Model.Vehiculo.Id })" class="btn btn-secondary">
                                <i class="fas fa-car"></i> Ver Vehículo
                            </a>
                        }

                        @if (Model.EstadoReserva != "Cancelada")
                        {
                            <form method="post" action="@Url.Action("Cancelar", "Reservas", new { id = Model.Id })" style="display: inline;" onsubmit="return confirm('¿Deseas cancelar esta reserva? Esta acción no se puede deshacer.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-times"></i> Cancelar Reserva
                                </button>
                            </form>
                        }

                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                            <i class="fas fa-home"></i> Inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions
{
    private string GetBadgeColor(string estado)
    {
        switch (estado)
        {
            case "Confirmada":
                return "success";
            case "Pendiente":
                return "warning text-dark";
            case "Cancelada":
                return "danger";
            default:
                return "secondary";
        }
    }

    private string GetVehiculoBadgeColor(string estado)
    {
        switch (estado)
        {
            case "Disponible":
                return "success";
            case "Reservado":
                return "warning text-dark";
            case "Vendido":
                return "danger";
            default:
                return "secondary";
        }
    }
}

<style>
    .table-sm td {
        vertical-align: middle;
    }

    .alert {
        border-radius: 0.5rem;
    }

    .fs-6 {
        font-size: 1.1rem;
    }

    @@media (max-width: 768px) {
        .col-md-4, .col-md-6, .col-md-8 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }
</style>
