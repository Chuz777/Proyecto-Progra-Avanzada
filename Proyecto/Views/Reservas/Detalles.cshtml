@model Proyecto.Models.Entities.ReservaVisita

@{
    ViewBag.Title = "Reserva Confirmada";
}

<div class="page-header">
    <span class="label">Concesionario</span>
    <h2>¡Reserva Solicitada con Éxito!</h2>
</div>

<div class="page-content" style="max-width: 600px; margin: 0 auto;">
    <div style="background: #1a1a1a; padding: 2rem; border-radius: 8px; border: 1px solid #333333; color: #ffffff; text-align: center;">
        <div style="font-size: 3rem; color: #52c41a; margin-bottom: 1rem;">✓</div>

        <h3 style="margin-top: 0;">Gracias, @Model.NombreContacto</h3>
        <p style="color: #a0a0a0;">Hemos recibido tu solicitud de visita. Nos pondremos en contacto contigo pronto para confirmar.</p>

        <hr style="border: 0; border-top: 1px solid #333333; margin: 1.5rem 0;" />

        <div style="text-align: left; background: #111111; padding: 1rem; border-radius: 6px; margin-bottom: 1.5rem;">
            <p style="margin: 0.5rem 0;"><strong>Vehículo:</strong> @Model.Vehiculo.Marca @Model.Vehiculo.Modelo</p>
            <p style="margin: 0.5rem 0;"><strong>Fecha Solicitada:</strong> @Model.FechaVista.ToString("dd/MM/yyyy hh:mm tt")</p>
            <p style="margin: 0.5rem 0;"><strong>Estado:</strong> <span style="color: #d4b106; font-weight: bold;">@Model.EstadoReserva</span></p>
            <p style="margin: 0.5rem 0;"><strong>Teléfono de Contacto:</strong> @Model.TelefonoContacto</p>
        </div>

        <a href="@Url.Action("Index", "Vehiculo")" class="boton btn-primary" style="display: inline-block; text-decoration: none;">
            Volver al Catálogo
        </a>
    </div>
</div>