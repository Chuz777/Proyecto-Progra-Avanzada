@model Proyecto.Models.Entities.ReservaVisita

@{
    ViewBag.Title = "Reservar Cita";
    var vehiculo = ViewBag.Vehiculo;
}

<div class="page-header">
    <span class="label">Concesionario</span>
    <h2>Reservar Cita de Visita</h2>
</div>

<div class="page-content">
    @if (vehiculo != null)
    {
        <div class="reserva-grid">
   
            <div>
                @if (!string.IsNullOrEmpty(vehiculo.ImagenUrl))
                {
                    <img src="@vehiculo.ImagenUrl" alt="@vehiculo.Marca @vehiculo.Modelo" class="vehiculo-preview-img" />
                }

                <div class="vehiculo-info-card">
                    <h3>@vehiculo.Marca @vehiculo.Modelo</h3>
                    <p><strong>Año:</strong> @vehiculo.Anio</p>
                    <p><strong>Descripción:</strong> @vehiculo.Descripcion</p>
                    <p class="vehiculo-precio">₡@vehiculo.Precio.ToString("N0")</p>
                </div>
            </div>

            <div>
                @using (Html.BeginForm("Create", "Reservas", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.VehiculoId)

                    <div class="reserva-form-card">
                        <h4 class="form-title">Tus Datos de Contacto</h4>

                        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                        <div class="form-group">
                            <label for="NombreContacto" class="form-label">Nombre Completo</label>
                            @Html.TextBoxFor(m => m.NombreContacto, new { @class = "form-input-dark", @required = "required", @placeholder = "Ej: Juan Pérez" })
                            @Html.ValidationMessageFor(m => m.NombreContacto, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label for="EmailContacto" class="form-label">Correo Electrónico</label>
                            @Html.TextBoxFor(m => m.EmailContacto, new { @type = "email", @class = "form-input-dark", @required = "required", @placeholder = "tu@email.com" })
                            @Html.ValidationMessageFor(m => m.EmailContacto, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label for="TelefonoContacto" class="form-label">Teléfono</label>
                            @Html.TextBoxFor(m => m.TelefonoContacto, new { @type = "tel", @class = "form-input-dark", @required = "required", @placeholder = "+506 8000-0000" })
                            @Html.ValidationMessageFor(m => m.TelefonoContacto, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group-last">
                            <label for="FechaVista" class="form-label">Fecha y Hora que deseas visitar</label>
                            @Html.TextBoxFor(m => m.FechaVista, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-input-dark", @type = "datetime-local", @required = "required" })
                            @Html.ValidationMessageFor(m => m.FechaVista, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="boton btn-primary btn-flex">
                                ✓ Confirmar Reserva
                            </button>
                            <a href="@Url.Action("Index", "Autos")" class="btn-secondary-dark">
                                Cancelar
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var fechaInput = document.querySelector('input[type="datetime-local"]');
        if (fechaInput) {
            var tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            var minDate = tomorrow.toISOString().slice(0, 16);
            fechaInput.setAttribute('min', minDate);
        }
    });
</script>